<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Release gate (AgentBridge convention): IsPrerelease=true while iterating → the
         version carries "-prerelease" and the release workflow skips. Set to false only
         when the test cycles proved the version works → pushing master with the gate off
         triggers release.yml automatically (tag v1.yy.MM.dd created by the workflow).
         Date-based auto version (1.yy.MM.dd). -->
    <IsPrerelease>true</IsPrerelease>
    <!-- ReleaseDate: date of the intended release version 1.yy.MM.dd. Empty (default) →
         the BUILD date is used; the gate-off commit pins it to the LOCAL push date so CI
         (DateTime.Now = UTC) can never derive the previous UTC day and reuse a version. -->
    <ReleaseDate Condition="'$(ReleaseDate)' == ''">$([System.DateTime]::Now.ToString("yy.MM.dd"))</ReleaseDate>
    <Version Condition="'$(IsPrerelease)' == 'true'">1.$(ReleaseDate)-prerelease</Version>
    <Version Condition="'$(IsPrerelease)' != 'true'">1.$(ReleaseDate)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <ApplicationIcon>Cloud.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <RootNamespace>Cloud</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Cloud.ico" />
    <Content Include="Components\Pages\Home.razor_" />
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md" Link="LICENSE.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Include="..\README.md" Link="README.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Dual-reference pattern: the local sibling projects win in solution builds; the
         published NuGet packages are restored when the siblings are absent (public CI
         cannot check out the private sibling repos). CloudClient.csproj is in this repo. -->
    <ProjectReference Include="..\..\..\AntiGit\AntiGit\AntiGitLibrary.csproj" Condition="Exists('..\..\..\AntiGit\AntiGit\AntiGitLibrary.csproj')" />
    <PackageReference Include="AntiGitLibrary" Version="1.*" Condition="!Exists('..\..\..\AntiGit\AntiGit\AntiGitLibrary.csproj')" />
    <ProjectReference Include="..\..\..\AppSync\AppSync.csproj" Condition="Exists('..\..\..\AppSync\AppSync.csproj')" />
    <PackageReference Include="AppSync" Version="1.*" Condition="!Exists('..\..\..\AppSync\AppSync.csproj')" />
    <ProjectReference Include="..\..\..\SystemExtra\SystemExtra.csproj" Condition="Exists('..\..\..\SystemExtra\SystemExtra.csproj')" />
    <PackageReference Include="SystemExtra" Version="1.*" Condition="!Exists('..\..\..\SystemExtra\SystemExtra.csproj')" />
    <ProjectReference Include="..\..\..\UISupportBlazor\UISupportBlazor.csproj" Condition="Exists('..\..\..\UISupportBlazor\UISupportBlazor.csproj')" />
    <PackageReference Include="UISupportBlazor" Version="1.*" Condition="!Exists('..\..\..\UISupportBlazor\UISupportBlazor.csproj')" />
    <ProjectReference Include="..\CloudClient\CloudClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="install.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="install.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="INSTALL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="redirect.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="uninstall.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="CloudClient.wpp.targets" Condition="Exists('CloudClient.wpp.targets')" />
</Project>
